GRAPH.QUERY social_graph "CREATE INDEX ON :User(user_id)"
GRAPH.QUERY social_graph "CREATE (:User {user_id: 1001, username: 'alice', display_name: 'Alice Johnson'})"
GRAPH.QUERY social_graph "CREATE (:User {user_id: 1002, username: 'bob', display_name: 'Bob Smith'})"
GRAPH.QUERY social_graph "CREATE (:User {user_id: 1003, username: 'charlie', display_name: 'Charlie Brown'})"
GRAPH.QUERY social_graph "CREATE (:User {user_id: 1004, username: 'david', display_name: 'David Miller'})"
GRAPH.QUERY social_graph "CREATE (:User {user_id: 1005, username: 'eva', display_name: 'Eva Davis'})"
GRAPH.QUERY social_graph "MATCH (a:User {user_id: 1001}), (b:User {user_id: 1002}) CREATE (a)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(b), (b)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(a)"
GRAPH.QUERY social_graph "MATCH (a:User {user_id: 1001}), (c:User {user_id: 1003}) CREATE (a)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(c), (c)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(a)"
GRAPH.QUERY social_graph "MATCH (a:User {user_id: 1001}), (d:User {user_id: 1004}) CREATE (a)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(d), (d)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(a)"
GRAPH.QUERY social_graph "MATCH (b:User {user_id: 1002}), (e:User {user_id: 1005}) CREATE (b)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(e), (e)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(b)"
GRAPH.QUERY social_graph "MATCH (c:User {user_id: 1003}), (d:User {user_id: 1004}) CREATE (c)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(d), (d)-[:FRIENDS_WITH {status: 'ACCEPTED'}]->(c)"
