FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/NewsFeed.Common/*.csproj src/NewsFeed.Common/
COPY src/NewsFeed.Api/*.csproj src/NewsFeed.Api/
COPY src/NewsFeed.Worker/*.csproj src/NewsFeed.Worker/
RUN dotnet restore src/NewsFeed.Api/NewsFeed.Api.csproj

COPY src/NewsFeed.Common/ src/NewsFeed.Common/
COPY src/NewsFeed.Api/ src/NewsFeed.Api/
RUN dotnet publish src/NewsFeed.Api/NewsFeed.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8000
EXPOSE 8000

USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["dotnet", "NewsFeed.Api.dll"]
